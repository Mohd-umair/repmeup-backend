{
  "name": "orm-backend",
  "version": "1.0.0",
  "description": "ORM System Backend API - Online Reputation Management Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "worker:campaign": "node src/campaignWorker.js",
    "seed:reports-menu": "node scripts/addReportsMenu.js",
    "dev": "nodemon src/server.js",
    "dev:worker": "nodemon src/worker.js",
    "dev:campaign-worker": "nodemon src/campaignWorker.js",
    "decode-entities": "node scripts/decodeStoredHtmlEntities.js",
    "seed:menus": "node scripts/seedAllMenus.js",
    "seed:menus:force": "node scripts/seedAllMenus.js --force",
    "seed:plans": "node scripts/seedPlans.js",
    "seed:features": "node scripts/seedFeatures.js",
    "seed:free-plan": "node scripts/seedFreePlanEntitlements.js",
    "seed:flow-blueprints": "node scripts/seed-automation-flow-blueprints.js",
    "migrate:wa-flows": "node scripts/migrate-whatsapp-flows-to-automation.js",
    "migrate:plans-inr": "node scripts/migratePlanPricesToInr.js",
    "setup:razorpay-plans": "node scripts/setup-razorpay-plans.js",
    "create-super-admin": "node scripts/createSuperAdmin.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "pm2:small": "pm2 start ecosystem.small.config.js --env production",
    "pm2:medium": "pm2 start ecosystem.medium.config.js --env production",
    "pm2:large": "pm2 start ecosystem.large.config.js --env production",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:delete": "pm2 delete all",
    "pm2:logs": "pm2 logs",
    "pm2:monitor": "pm2 monit"
  },
  "keywords": [
    "orm",
    "social-media",
    "reputation-management",
    "unified-inbox"
  ],
  "author": "ORM Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@bull-board/api": "^6.18.1",
    "@bull-board/express": "^6.18.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.5",
    "google-libphonenumber": "^3.2.44",
    "googleapis": "^171.2.0",
    "helmet": "^7.1.0",
    "imapflow": "^1.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.2",
    "mailparser": "^3.9.8",
    "moment": "^2.30.1",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.6",
    "redis": "^4.6.11",
    "sharp": "^0.33.5",
    "socket.io": "^4.6.1",
    "twilio": "^6.0.2",
    "validator": "^13.15.26",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.20.1",
    "xlsx": "^0.18.5",
    "youtube-transcript": "^1.3.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
